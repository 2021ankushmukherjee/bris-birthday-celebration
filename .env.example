# Used by the static client bundle. Rebuild after changing these values.
NEXT_PUBLIC_BIRTHDAY_PERSON_NAME=Bristi
# Month and day in the visitor's local time. Format: MM-DD
NEXT_PUBLIC_BIRTH_DATE=11-20
# Set false to skip the countdown and open the invitation immediately.
NEXT_PUBLIC_COUNTDOWN_ENABLED=true
# Set this only for a GitHub project Pages deployment, e.g. /repository-name.
NEXT_PUBLIC_BASE_PATH=
